{
  "name": "readweave",
  "private": true,
  "version": "0.1.0-alpha.13",
  "description": "在原文旁理解，顺畅继续阅读。",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run lint && npm test && npm run build",
    "lint": "eslint . --max-warnings 0",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "android:init": "tauri android init",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:dev": "tauri android dev",
    "samples": "node scripts/generate-samples.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "notices": "node scripts/generate-notices.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "dompurify": "3.4.17",
    "fflate": "0.8.3",
    "katex": "0.19.0",
    "lucide-react": "1.56.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "zod": "4.6.7"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tauri-apps/cli": "2.12.2",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
